local clock = os.clock
local started = clock()
local objectIds, objectPaths, propertyCache = {}, {}, {}
local work = 0

local function pause()
    work += 1
    if work % options.yieldEvery == 0 and task and type(task.wait) == "function" then
        task.wait()
    end
end

local function failure(path, message)
    profile.stats.errors += 1
    if #profile.errors < options.maxErrors then
        table.insert(profile.errors, { path = path, message = tostring(message):sub(1, 512) })
    end
end

local function quote(value)
    local valid = utf8.len(value) ~= nil
    local result = value:gsub("[%z\1-\31\127-\255\\\"]", function(character)
        if character == "\"" then return "\\\""
        elseif character == "\\" then return "\\\\"
        elseif character == "\n" then return "\\n"
        elseif character == "\r" then return "\\r"
        elseif character == "\t" then return "\\t"
        elseif string.byte(character) >= 128 and valid then return character
        end
        return string.format("\\%03d", string.byte(character))
    end)
    return "\"" .. result .. "\""
end

local function number(value)
    if value ~= value then return "(0/0)"
    elseif value == math.huge then return "math.huge"
    elseif value == -math.huge then return "-math.huge"
    end
    return string.format("%.17g", value)
end

local function literal(value, depth)
    depth = depth or 0
    local kind = type(value)
    if kind == "string" then return quote(value)
    elseif kind == "number" then return number(value)
    elseif kind ~= "table" then return tostring(value)
    end
    local keys = {}
    for key in value do
        table.insert(keys, key)
    end
    table.sort(keys, function(a, b)
        if type(a) == type(b) then
            return a < b
        end
        return type(a) < type(b)
    end)
    local parts = { "{" }
    for _, key in keys do
        table.insert(parts, "\n" .. string.rep("    ", depth + 1) .. "[" .. literal(key) .. "] = " .. literal(value[key], depth + 1) .. ",")
    end
    if #keys > 0 then
        table.insert(parts, "\n" .. string.rep("    ", depth))
    end
    table.insert(parts, "}")
    return table.concat(parts)
end

local snapshot
snapshot = function(value, depth, seen)
    depth, seen = depth or 0, seen or {}
    local kind = typeof(value)
    if value == nil then
        return { __type = "nil" }
    elseif kind == "string" or kind == "number" or kind == "boolean" then
        return value
    elseif kind == "Instance" then
        local name, className, path = "?", "?", nil
        pcall(function() name, className, path = value.Name, value.ClassName, value:GetFullName() end)
        return { __type = "Instance", id = objectIds[value], name = name, className = className, path = path, segments = objectPaths[value] }
    elseif kind == "EnumItem" then
        return { __type = kind, enum = tostring(value.EnumType), name = value.Name, value = value.Value }
    elseif kind == "Vector3" or kind == "Vector3int16" then
        return { __type = kind, values = { value.X, value.Y, value.Z } }
    elseif kind == "Vector2" or kind == "Vector2int16" then
        return { __type = kind, values = { value.X, value.Y } }
    elseif kind == "CFrame" then
        return { __type = kind, values = { value:GetComponents() } }
    elseif kind == "Color3" then
        return { __type = kind, values = { value.R, value.G, value.B } }
    elseif kind == "UDim" then
        return { __type = kind, values = { value.Scale, value.Offset } }
    elseif kind == "UDim2" then
        return { __type = kind, values = { value.X.Scale, value.X.Offset, value.Y.Scale, value.Y.Offset } }
    elseif kind == "BrickColor" then
        return { __type = kind, values = { value.Number }, name = value.Name, color = snapshot(value.Color) }
    elseif kind == "NumberRange" then
        return { __type = kind, values = { value.Min, value.Max } }
    elseif kind == "Ray" then
        return { __type = kind, values = { snapshot(value.Origin), snapshot(value.Direction) } }
    elseif kind == "Rect" then
        return { __type = kind, values = { snapshot(value.Min), snapshot(value.Max) } }
    elseif kind == "NumberSequence" or kind == "ColorSequence" then
        return { __type = kind, values = { snapshot(value.Keypoints, depth + 1, seen) } }
    elseif kind == "NumberSequenceKeypoint" then
        return { __type = kind, values = { value.Time, value.Value, value.Envelope } }
    elseif kind == "ColorSequenceKeypoint" then
        return { __type = kind, values = { value.Time, snapshot(value.Value) } }
    elseif kind == "PhysicalProperties" then
        return { __type = kind, values = { value.Density, value.Friction, value.Elasticity, value.FrictionWeight, value.ElasticityWeight } }
    elseif kind == "Font" then
        return { __type = kind, values = { value.Family, snapshot(value.Weight), snapshot(value.Style) } }
    elseif kind == "DateTime" then
        return { __type = kind, unixTimestampMillis = value.UnixTimestampMillis }
    elseif kind == "Region3" then
        return { __type = kind, cframe = snapshot(value.CFrame), size = snapshot(value.Size) }
    elseif kind == "Region3int16" then
        return { __type = kind, min = snapshot(value.Min), max = snapshot(value.Max) }
    elseif kind == "buffer" then
        local length = buffer.len(value)
        return { __type = kind, length = length, bytes = buffer.tostring(value) }
    elseif kind == "table" then
        if seen[value] then return { __type = "cycle" } end
        if depth >= 12 then return { __type = "table", truncated = true } end
        seen[value] = true
        local result, count = {}, 0
        for key, item in next, value do
            count += 1
            if count > options.maxTableEntries then
                result.__truncated = true
                break
            end
            if type(key) == "string" or type(key) == "number" then
                result[key] = snapshot(item, depth + 1, seen)
            end
        end
        seen[value] = nil
        return result
    end
    local result = { __type = kind }
    if kind == "TweenInfo" then
        for _, key in { "Time", "EasingStyle", "EasingDirection", "RepeatCount", "Reverses", "DelayTime" } do
            pcall(function() result[key] = snapshot(value[key]) end)
        end
    elseif kind == "Axes" or kind == "Faces" then
        for _, key in if kind == "Axes" then { "X", "Y", "Z" } else { "Top", "Bottom", "Left", "Right", "Front", "Back" } do
            pcall(function() result[key] = value[key] end)
        end
    elseif kind ~= "function" and kind ~= "thread" and kind ~= "userdata" then
        pcall(function() result.display = tostring(value):sub(1, 512) end)
    end
    return result
end

local function probe(target, name, callback)
    pause()
    profile.stats.probes += 1
    local values = table.pack(pcall(callback))
    if not values[1] then
        target[name] = { ok = false, error = tostring(values[2]):sub(1, 512) }
        return
    end
    local result = { ok = true, count = values.n - 1, values = {} }
    for index = 2, values.n do
        local ok, captured = pcall(snapshot, values[index])
        result.values[index - 1] = if ok then captured else { __type = "capture-error", error = tostring(captured):sub(1, 512) }
    end
    target[name] = result
end

local function read(object, property, path)
    pause()
    profile.stats.reads += 1
    local ok, value = pcall(function() return object[property] end)
    if not ok then
        return nil, tostring(value):sub(1, 512)
    end
    local captured, result = pcall(snapshot, value)
    if not captured then
        failure(path .. "." .. property, result)
        return nil, tostring(result):sub(1, 512)
    end
    return result
end

local function privateProperty(name)
    local lower = name:lower()
    return lower == "source" or lower:find("cookie", 1, true) or lower:find("password", 1, true) or lower:find("secret", 1, true) or lower:find("token", 1, true) or lower:find("apikey", 1, true) or lower:find("auth", 1, true) or lower:find("ticket", 1, true)
end

local function propertiesFor(className)
    if propertyCache[className] then return propertyCache[className] end
    local properties, seen = {}, {}
    local current = className
    while current and catalog.classes[current] and not seen[current] do
        seen[current] = true
        local description = catalog.classes[current]
        for name, descriptor in description.properties do
            if not properties[name] and descriptor.read == "None" and not privateProperty(name) then
                properties[name] = descriptor
            end
        end
        current = description.super
    end
    propertyCache[className] = properties
    return properties
end

local function inspect(object, path)
    local className = object.ClassName
    local result = { className = className, name = object.Name, properties = {}, unavailable = {}, attributes = {} }
    for property in propertiesFor(className) do
        local value, message = read(object, property, path)
        if message then
            result.unavailable[property] = message
        else
            result.properties[property] = value
        end
    end
    local ok, attributes = pcall(function() return object:GetAttributes() end)
    if ok then
        for name, value in attributes do
            if not privateProperty(name) then
                result.attributes[name] = snapshot(value)
            end
        end
    end
    return result
end

local function checkpoint(stage)
    profile.metadata.stage = stage
    profile.metadata.elapsedSeconds = clock() - started
    local contents = "return " .. literal(profile) .. "\n"
    writefile(options.output, contents)
    print("[Env] " .. stage .. ": " .. #contents .. " bytes written to " .. options.output)
end

local function global(name)
    local value = rawget(environment, name)
    if value == nil then
        local ok, found = pcall(function() return getfenv(0)[name] end)
        if ok then value = found end
    end
    return value
end

local function metadata()
    profile.metadata.startedAt = os.date("!%Y-%m-%dT%H:%M:%SZ")
    profile.metadata.epoch = os.time()
    profile.metadata.catalogClasses = 0
    for _ in catalog.classes do profile.metadata.catalogClasses += 1 end
    profile.metadata.luaVersion = _VERSION
    for _, name in { "identifyexecutor", "getexecutorname", "getexecutorversion", "version", "getversion", "getos", "getfpscap", "getthreadidentity", "getidentity", "getcontext" } do
        local callback = global(name)
        if type(callback) == "function" then
            probe(profile.metadata, name, callback)
        else
            profile.metadata[name] = { ok = false, unavailable = true }
        end
    end
    local identity = profile.metadata.identifyexecutor
    if identity and identity.ok then
        profile.metadata.executorName = identity.values[1]
        profile.metadata.executorVersion = identity.values[2]
    end
    local client = profile.metadata.version
    if client and client.ok then profile.metadata.robloxVersion = client.values[1] end
    profile.metadata.placeId, profile.metadata.gameId = game.PlaceId, game.GameId
    profile.metadata.jobId = game.JobId
    profile.metadata.loaded = game:IsLoaded()
    profile.metadata.catalogIsLive = false
end

local function libraries()
    for _, name in { "math", "vector", "string", "table", "bit32", "utf8", "buffer", "coroutine", "task", "os", "debug", "Drawing", "syn", "crypt", "WebSocket", "cache" } do
        local library = global(name)
        local result = { available = type(library) == "table", members = {} }
        if type(library) == "table" then
            for key, value in next, library do
                if type(key) == "string" then
                    local kind = typeof(value)
                    local member = { type = kind }
                    if (name == "math" or name == "utf8") and (type(value) == "number" or type(value) == "string" or type(value) == "boolean") then
                        member.value = value
                    elseif type(value) == "function" then
                        for _, predicate in { "iscclosure", "islclosure" } do
                            local test = global(predicate)
                            if type(test) == "function" then
                                local ok, answer = pcall(test, value)
                                if ok then member[predicate] = answer end
                            end
                        end
                    end
                    result.members[key] = member
                end
            end
        end
        profile.libraries[name] = result
    end
    for key, value in next, environment do
        if type(key) == "string" and not privateProperty(key) then
            profile.globals[key] = { type = typeof(value) }
        end
    end
    for _, name in capabilityNames do
        local value = global(name)
        profile.capabilities[name] = { available = value ~= nil, type = typeof(value) }
    end
end

local function mathProbes()
    local values = { -1000000, -1024, -360, -180, -90, -math.pi, -2, -1, -0.5, -1e-12, -0, 0, 1e-12, 0.5, 1, 2, math.pi, 90, 180, 360, 1024, 1000000, math.huge, -math.huge, 0 / 0 }
    for _, name in { "abs", "acos", "acosh", "asin", "asinh", "atan", "atanh", "ceil", "cos", "cosh", "deg", "exp", "floor", "frexp", "log", "log10", "modf", "rad", "round", "sign", "sin", "sinh", "sqrt", "tan", "tanh", "isfinite", "isinf", "isnan" } do
        local callback = math[name]
        local result = { available = type(callback) == "function", cases = {} }
        if type(callback) == "function" then
            for index, value in values do
                local label = tostring(index) .. ":" .. number(value)
                probe(result.cases, label, function() return callback(value) end)
            end
        end
        profile.math[name] = result
    end
    local inputs = { -4, -1, -0.25, 0, 0.25, 1, 2, 4, 16 }
    for _, name in { "atan2", "fmod", "ldexp", "log", "max", "min", "pow" } do
        local callback = math[name]
        local result = { available = type(callback) == "function", cases = {} }
        if type(callback) == "function" then
            for _, a in inputs do
                for _, b in inputs do
                    probe(result.cases, number(a) .. "," .. number(b), function() return callback(a, b) end)
                end
            end
        end
        profile.math[name .. ":binary"] = result
    end
    for _, name in { "clamp", "lerp", "map", "noise" } do
        local callback = math[name]
        local result = { available = type(callback) == "function", cases = {} }
        if type(callback) == "function" then
            for _, a in inputs do
                probe(result.cases, number(a), function()
                    if name == "clamp" then return callback(a, -1, 1)
                    elseif name == "lerp" then return callback(-10, 10, a)
                    elseif name == "map" then return callback(a, -4, 16, 0, 1)
                    end
                    return callback(a, a / 2, a / 4)
                end)
            end
        end
        profile.math[name] = result
    end
end

local function datatypeProbes()
    local function capture(name, cases)
        local result = { available = global(name) ~= nil, cases = {} }
        for label, callback in cases do probe(result.cases, label, callback) end
        profile.datatypes[name] = result
        return result
    end
    for _, name in { "Vector2", "Vector3" } do
        local library = global(name)
        local result = capture(name, {})
        if library then
            local vectors = if name == "Vector3" then { library.new(), library.new(1, 2, 3), library.new(-7, 0.25, 90), library.new(0.001, -0.002, 0.003) } else { library.new(), library.new(1, 2), library.new(-7, 0.25), library.new(0.001, -0.002) }
            for index, vector in vectors do
                for _, property in { "X", "Y", "Z", "Magnitude", "Unit", "x", "y", "z", "magnitude", "unit" } do
                    probe(result.cases, index .. ":" .. property, function() return vector[property] end)
                end
                for _, method in { "Dot", "Cross", "Lerp", "Angle", "FuzzyEq", "Max", "Min" } do
                    probe(result.cases, index .. ":" .. method, function() return vector[method](vector, vectors[2], 0.25) end)
                end
                for _, scalar in { -2, -0.25, 0, 0.25, 2 } do
                    probe(result.cases, index .. ":mul:" .. scalar, function() return vector * scalar end)
                    probe(result.cases, index .. ":div:" .. scalar, function() return vector / scalar end)
                end
                probe(result.cases, index .. ":add", function() return vector + vectors[2] end)
                probe(result.cases, index .. ":sub", function() return vector - vectors[2] end)
                probe(result.cases, index .. ":neg", function() return -vector end)
            end
            for _, property in { "zero", "one", "xAxis", "yAxis", "zAxis" } do
                probe(result.cases, property, function() return library[property] end)
            end
        end
    end
    local cframes = { CFrame.new(), CFrame.new(1, 2, 3), CFrame.Angles(0.25, -0.5, 1), CFrame.lookAt(Vector3.new(1, 2, 3), Vector3.new(4, 5, 6)) }
    local cframe = capture("CFrame", {})
    for index, value in cframes do
        for _, property in { "Position", "Rotation", "X", "Y", "Z", "LookVector", "RightVector", "UpVector", "XVector", "YVector", "ZVector" } do
            probe(cframe.cases, index .. ":" .. property, function() return value[property] end)
        end
        for _, method in { "GetComponents", "ToEulerAnglesXYZ", "ToEulerAnglesYXZ", "ToOrientation", "ToAxisAngle", "Inverse", "Orthonormalize" } do
            probe(cframe.cases, index .. ":" .. method, function() return value[method](value) end)
        end
        for _, method in { "PointToWorldSpace", "PointToObjectSpace", "VectorToWorldSpace", "VectorToObjectSpace" } do
            probe(cframe.cases, index .. ":" .. method, function() return value[method](value, Vector3.new(7, 8, 9)) end)
        end
        probe(cframe.cases, index .. ":multiply", function() return value * cframes[2] end)
        probe(cframe.cases, index .. ":lerp", function() return value:Lerp(cframes[2], 0.25) end)
    end
    capture("Color3", {
        zero = function() return Color3.new() end,
        rgb = function() return Color3.fromRGB(12, 128, 255) end,
        hsv = function() return Color3.fromHSV(0.6, 0.5, 0.9) end,
        hex = function() return Color3.fromHex("33aaee") end,
        toHSV = function() return Color3.fromRGB(12, 128, 255):ToHSV() end,
        toHex = function() return Color3.fromRGB(12, 128, 255):ToHex() end,
        lerp = function() return Color3.new(1, 0, 0):Lerp(Color3.new(0, 0, 1), 0.5) end,
    })
    local cases = {
        UDim = function() return UDim.new(0.5, 24) end,
        UDim2 = function() return UDim2.new(0.5, 24, 1, -8), UDim2.fromOffset(320, 180), UDim2.fromScale(1, 1) end,
        Vector2int16 = function() return Vector2int16.new(4, -9) end,
        Vector3int16 = function() return Vector3int16.new(4, -9, 16) end,
        BrickColor = function() return BrickColor.new(194), BrickColor.new("Really red") end,
        NumberRange = function() return NumberRange.new(2, 8) end,
        Ray = function() return Ray.new(Vector3.new(1, 2, 3), Vector3.new(4, 5, 6)) end,
        Rect = function() return Rect.new(0, 0, 320, 180) end,
        Region3 = function() return Region3.new(Vector3.new(-4, -4, -4), Vector3.new(4, 4, 4)) end,
        Region3int16 = function() return Region3int16.new(Vector3int16.new(-4, -4, -4), Vector3int16.new(4, 4, 4)) end,
        NumberSequence = function() return NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25, 0.1), NumberSequenceKeypoint.new(1, 0.75, 0.2) }) end,
        ColorSequence = function() return ColorSequence.new(Color3.new(1, 0, 0), Color3.new(0, 0, 1)) end,
        NumberSequenceKeypoint = function() return NumberSequenceKeypoint.new(0.5, 0.75, 0.1) end,
        ColorSequenceKeypoint = function() return ColorSequenceKeypoint.new(0.5, Color3.new(1, 0, 0)) end,
        PhysicalProperties = function() return PhysicalProperties.new(0.7, 0.5, 0.3, 1, 1) end,
        TweenInfo = function() return TweenInfo.new(), TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, 2, true, 0.1) end,
        Axes = function() return Axes.new(Enum.Axis.X, Enum.Axis.Z) end,
        Faces = function() return Faces.new(Enum.NormalId.Top, Enum.NormalId.Front) end,
        Font = function() return Font.fromEnum(Enum.Font.SourceSans) end,
        DateTime = function() return DateTime.fromUnixTimestampMillis(1700000000123) end,
    }
    for name, callback in cases do capture(name, { constructor = callback }) end
    local random = capture("Random", {})
    for _, seed in { 0, 1, 42, -1, 2147483647 } do
        probe(random.cases, tostring(seed), function()
            local generator = Random.new(seed)
            return generator:NextNumber(), generator:NextNumber(-10, 10), generator:NextInteger(1, 100), generator:NextUnitVector()
        end)
    end
end

local function standardProbes()
    local strings = { "", "hello", "AbC123", "a\0b", "\255\128", "\tline\nnext\r", "mobile 📱", "αβγ" }
    local output = { string = {}, table = {}, bit32 = {}, utf8 = {}, buffer = {}, coroutine = {} }
    profile.standard = output
    for index, value in strings do
        for _, name in { "len", "byte", "lower", "upper", "reverse" } do
            probe(output.string, index .. ":" .. name, function() return string[name](value) end)
        end
        probe(output.string, index .. ":sub", function() return string.sub(value, 2, -2) end)
        probe(output.string, index .. ":find", function() return string.find(value, "%a+") end)
        probe(output.string, index .. ":match", function() return string.match(value, "%w+") end)
        probe(output.string, index .. ":gsub", function() return string.gsub(value, "(%a)", "[%1]") end)
        probe(output.string, index .. ":split", function() return string.split(value, " ") end)
        probe(output.utf8, index .. ":len", function() return utf8.len(value) end)
        probe(output.utf8, index .. ":codepoint", function() return utf8.codepoint(value, 1, #value) end)
    end
    probe(output.string, "format", function() return string.format("%q %d %.9g %x", "a\0b", -12, math.pi, 255) end)
    probe(output.string, "pack", function() return string.pack("<i4f", -123, 0.25) end)
    probe(output.table, "pack", function() return table.pack(1, nil, false, nil) end)
    probe(output.table, "clone", function() return table.clone({ 1, 2, false }) end)
    probe(output.table, "create", function() return table.create(3, false) end)
    probe(output.table, "find", function() return table.find({ "a", "b", "c" }, "b") end)
    probe(output.table, "move", function() return table.move({ 1, 2, 3 }, 1, 3, 2, {}) end)
    probe(output.table, "freeze", function() return table.isfrozen(table.freeze({})) end)
    probe(output.coroutine, "yield", function()
        local thread = coroutine.create(function() coroutine.yield(1, nil, 3); return 4, nil, 6 end)
        local first = table.pack(coroutine.resume(thread))
        local second = table.pack(coroutine.resume(thread))
        return first, second, coroutine.status(thread)
    end)
    for _, name in { "band", "bor", "bxor", "btest", "lshift", "rshift", "arshift", "lrotate", "rrotate" } do
        for _, value in { 0, 1, 255, 2147483648, 4294967295 } do
            probe(output.bit32, name .. ":" .. value, function() return bit32[name](value, 3) end)
        end
    end
    probe(output.bit32, "bnot", function() return bit32.bnot(255) end)
    probe(output.bit32, "extract", function() return bit32.extract(65535, 4, 8) end)
    probe(output.bit32, "replace", function() return bit32.replace(0, 255, 8, 8) end)
    probe(output.buffer, "bytes", function()
        local value = buffer.create(64)
        buffer.writei32(value, 0, -123)
        buffer.writeu32(value, 4, 4294967295)
        buffer.writef32(value, 8, 0.25)
        buffer.writef64(value, 16, math.pi)
        return buffer.len(value), buffer.readi32(value, 0), buffer.readu32(value, 4), buffer.readf32(value, 8), buffer.readf64(value, 16), buffer.tostring(value)
    end)
end

local serviceObjects = {}
local function service(name)
    if serviceObjects[name] then return serviceObjects[name] end
    local ok, object = pcall(function() return game:GetService(name) end)
    if ok then serviceObjects[name] = object; return object end
    failure("service:" .. name, object)
end

local function client()
    local players, input, gui = service("Players"), service("UserInputService"), service("GuiService")
    local player = players and players.LocalPlayer
    if player then
        profile.player = inspect(player, "LocalPlayer")
        profile.metadata.playerName = player.Name
        profile.metadata.userId = player.UserId
        profile.metadata.displayName = player.DisplayName
        local character = player.Character
        if character then
            profile.character = inspect(character, "Character")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                profile.humanoid = inspect(humanoid, "Humanoid")
                probe(profile.humanoid, "GetState", function() return humanoid:GetState() end)
                for _, state in Enum.HumanoidStateType:GetEnumItems() do
                    probe(profile.humanoid, "StateEnabled:" .. state.Name, function() return humanoid:GetStateEnabled(state) end)
                end
            end
            local root = character:FindFirstChild("HumanoidRootPart")
            if root then profile.rootPart = inspect(root, "HumanoidRootPart") end
        end
    end
    if input then
        profile.input = inspect(input, "UserInputService")
        for _, property in { "TouchEnabled", "KeyboardEnabled", "MouseEnabled", "GamepadEnabled", "AccelerometerEnabled", "GyroscopeEnabled", "VREnabled", "PreferredInput" } do
            local value, message = read(input, property, "UserInputService")
            if not message then profile.input.properties[property] = value end
        end
        for _, method in { "GetPlatform", "GetLastInputType", "GetMouseLocation", "GetConnectedGamepads", "GetNavigationGamepads", "IsKeyDown" } do
            probe(profile.input, method, function()
                return if method == "IsKeyDown" then input:IsKeyDown(Enum.KeyCode.Space) else input[method](input)
            end)
        end
    end
    if gui then
        for _, method in { "GetGuiInset", "GetSafeZoneOffsets", "GetScreenResolution", "IsTenFootInterface", "IsWindows" } do
            probe(profile.screen, method, function() return gui[method](gui) end)
        end
        for _, property in { "TopbarInset", "TouchControlsEnabled", "IsModalDialog", "MenuIsOpen", "PreferredTransparency", "GuiNavigationEnabled" } do
            local value, message = read(gui, property, "GuiService")
            profile.screen[property] = if message then { unavailable = true, error = message } else value
        end
    end
    local camera = workspace.CurrentCamera
    if camera then
        profile.camera = inspect(camera, "CurrentCamera")
        profile.screen.viewport = snapshot(camera.ViewportSize)
        profile.screen.width, profile.screen.height = camera.ViewportSize.X, camera.ViewportSize.Y
        profile.screen.units = "Roblox viewport UI offset units"
        profile.screen.inferredOrientation = if camera.ViewportSize.X >= camera.ViewportSize.Y then "landscape" else "portrait"
        local points = { Vector3.zero, Vector3.new(0, 5, 0), Vector3.new(0, 0, -10), Vector3.new(10, 20, 30) }
        for index, point in points do
            probe(profile.camera, "WorldToViewportPoint:" .. index, function() return camera:WorldToViewportPoint(point) end)
            probe(profile.camera, "WorldToScreenPoint:" .. index, function() return camera:WorldToScreenPoint(point) end)
        end
        for index, point in { Vector2.zero, camera.ViewportSize / 2, camera.ViewportSize } do
            probe(profile.camera, "ViewportPointToRay:" .. index, function() return camera:ViewportPointToRay(point.X, point.Y, 0) end)
            probe(profile.camera, "ScreenPointToRay:" .. index, function() return camera:ScreenPointToRay(point.X, point.Y, 0) end)
        end
        probe(profile.camera, "GetRenderCFrame", function() return camera:GetRenderCFrame() end)
    end
    if player then
        local guiObject = player:FindFirstChildOfClass("PlayerGui")
        if guiObject then
            for _, property in { "ScreenOrientation", "CurrentScreenOrientation" } do
                local value, message = read(guiObject, property, "PlayerGui")
                profile.screen[property] = if message then { unavailable = true, error = message } else value
            end
        end
    end
    probe(profile.metadata, "UserGameSettings", function()
        return inspect(UserSettings():GetService("UserGameSettings"), "UserGameSettings")
    end)
end

local function enums()
    local ok, types = pcall(function() return Enum:GetEnums() end)
    if not ok then
        types = {}
        for _, name in catalog.enumNames do
            pcall(function() table.insert(types, Enum[name]) end)
        end
    end
    for _, enum in types do
        pause()
        local name = tostring(enum):gsub("^Enum%.", "")
        local success, items = pcall(function() return enum:GetEnumItems() end)
        if success then
            local result = {}
            for _, item in items do result[item.Name] = item.Value end
            profile.enums[name] = result
        else
            failure("Enum." .. name, items)
        end
    end
end

local function services()
    local ok, children = pcall(function() return game:GetChildren() end)
    if ok then
        for _, object in children do
            local description = catalog.classes[object.ClassName]
            if description and description.service then serviceObjects[object.ClassName] = object end
        end
    end
    for _, name in { "Workspace", "Players", "RunService", "UserInputService", "GuiService", "Lighting", "ReplicatedStorage", "ReplicatedFirst", "StarterGui", "StarterPack", "StarterPlayer", "SoundService", "Teams", "TextService", "TextChatService", "LocalizationService", "CollectionService", "TweenService", "HttpService", "Stats", "VRService" } do service(name) end
    for name, object in serviceObjects do
        local captured, result = pcall(inspect, object, name)
        if captured then profile.services[name] = result else failure(name, result) end
    end
end

local function world()
    if not options.includeWorld then return end
    local queue, index = {}, 1
    for _, name in { "Workspace", "ReplicatedStorage", "ReplicatedFirst", "Lighting", "StarterGui", "StarterPack", "StarterPlayer", "SoundService", "Teams", "TextChatService", "Players" } do
        local root = service(name)
        if root then table.insert(queue, { object = root, path = { name }, depth = 0 }) end
    end
    while index <= #queue and #profile.instances < options.maxInstances do
        local item = queue[index]
        index += 1
        if not objectIds[item.object] then
            local id = #profile.instances + 1
            objectIds[item.object], objectPaths[item.object] = id, item.path
            local result = inspect(item.object, table.concat(item.path, "."))
            result.id, result.path, result.parentId = id, item.path, item.parentId
            table.insert(profile.instances, result)
            if item.depth < options.maxDepth then
                local ok, children = pcall(function() return item.object:GetChildren() end)
                if ok then
                    for _, child in children do
                        local path = table.clone(item.path)
                        table.insert(path, child.Name)
                        table.insert(queue, { object = child, path = path, parentId = id, depth = item.depth + 1 })
                    end
                end
            end
        end
    end
    profile.stats.instances = #profile.instances
    profile.metadata.instanceLimitReached = index <= #queue
end

local function classDefaults()
    if not options.includeClassDefaults then return end
    local classes = {}
    for name, descriptor in catalog.classes do
        if descriptor.creatable and (#options.classNames == 0 or table.find(options.classNames, name)) then table.insert(classes, name) end
    end
    table.sort(classes)
    for _, name in classes do
        pause()
        local ok, object = pcall(Instance.new, name)
        if ok then
            profile.stats.created += 1
            local success, result = pcall(inspect, object, "default:" .. name)
            if success then profile.classDefaults[name] = result else failure("default:" .. name, result) end
            pcall(function() object:Destroy() end)
        else
            profile.classDefaults[name] = { unavailable = true, error = tostring(object):sub(1, 512) }
        end
    end
end

local function frames()
    for index = 1, options.frameSamples do
        if task and type(task.wait) == "function" then task.wait() end
        local sample = { elapsed = clock() - started, index = index }
        local camera = workspace.CurrentCamera
        if camera then sample.camera = { cframe = snapshot(camera.CFrame), focus = snapshot(camera.Focus), viewport = snapshot(camera.ViewportSize), fieldOfView = camera.FieldOfView } end
        local players = service("Players")
        local player = players and players.LocalPlayer
        local character = player and player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if humanoid then
            sample.humanoid = {}
            for _, key in { "WalkSpeed", "JumpPower", "JumpHeight", "UseJumpPower", "Health", "MaxHealth", "HipHeight", "MoveDirection", "FloorMaterial", "RigType" } do
                local value = read(humanoid, key, "sample.humanoid")
                sample.humanoid[key] = value
            end
        end
        if root then sample.rootPart = { cframe = snapshot(root.CFrame), position = snapshot(root.Position), velocity = snapshot(root.AssemblyLinearVelocity), size = snapshot(root.Size) } end
        table.insert(profile.samples, sample)
    end
end

