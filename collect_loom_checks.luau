).X\n        if a <= 0 or b <= 0 then return false end\n        local r = b / a\n        return r >= 3.2 and r <= 4.8\n    end); if not _loom_ok or _loom_value ~= true then _loom_failed = _loom_failed + 1 end","group":"roblox","id":"roblox.069","index":69,"source":"local _loom_failed=0; local _loom_ok,_loom_value;\n_loom_ok, _loom_value = pcall(function()\n        local TextService = game:GetService(\"TextService\")\n        local SS = Enum.Font.SourceSans\n        local BIG = Vector2.new(1e4, 1e4)\n        local a = TextService:GetTextSize(\"W\", 12, SS, BIG).X\n        local b = TextService:GetTextSize(\"W\", 48, SS, BIG).X\n        if a <= 0 or b <= 0 then return false end\n        local r = b / a\n        return r >= 3.2 and r <= 4.8\n    end); if not _loom_ok or _loom_value ~= true then _loom_failed = _loom_failed + 1 end\nreturn _loom_failed"},{"expression":"_loom_ok, _loom_value = pcall(function()\n        local TextService = game:GetService(\"TextService\")\n        local BIG = Vector2.new(1e4, 1e4)\n        local fonts = {\n            Enum.Font.SourceSans, Enum.Font.SourceSansBold, Enum.Font.Gotham,\n            Enum.Font.GothamBold, Enum.Font.Code, Enum.Font.Michroma,\n            Enum.Font.Arial, Enum.Font.Fantasy,\n        }\n        local seen, distinct = {}, 0\n        for _, f in ipairs(fonts) do\n            local w = TextService:GetTextSize(\"The quick brown fox 0123456789\", 24, f, BIG).X\n            if not seen[w] then seen[w] = true; distinct = distinct + 1 end\n        end\n        return distinct >= 3\n    end); if not _loom_ok or _loom_value ~= true then _loom_failed = _loom_failed + 1 end","group":"roblox","id":"roblox.070","index":70,"source":"local _loom_failed=0; local _loom_ok,_loom_value;\n_loom_ok, _loom_value = pcall(function()\n        local TextService = game:GetService(\"TextService\")\n        local BIG = Vector2.new(1e4, 1e4)\n        local fonts = {\n            Enum.Font.SourceSans, Enum.Font.SourceSansBold, Enum.Font.Gotham,\n            Enum.Font.GothamBold, Enum.Font.Code, Enum.Font.Michroma,\n            Enum.Font.Arial, Enum.Font.Fantasy,\n        }\n        local seen, distinct = {}, 0\n        for _, f in ipairs(fonts) do\n            local w = TextService:GetTextSize(\"The quick brown fox 0123456789\", 24, f, BIG).X\n            if not seen[w] then seen[w] = true; distinct = distinct + 1 end\n        end\n        return distinct >= 3\n    end); if not _loom_ok or _loom_value ~= true then _loom_failed = _loom_failed + 1 end\nreturn _loom_failed"},{"expression":"_loom_ok, _loom_value = pcall(function()\n        local TextService = game:GetService(\"TextService\")\n        local SS = Enum.Font.SourceSans\n        local BIG = Vector2.new(1e4, 1e4)\n        local w1 = TextService:GetTextSize(\"a\", 24, SS, BIG).X\n        local w2 = TextService:GetTextSize(\"aaaaaaaaaa\", 24, SS, BIG).X\n        return w2 > w1\n    end); if not _loom_ok or _loom_value ~= true then _loom_failed = _loom_failed + 1 end","group":"roblox","id":"roblox.071","index":71,"source":"local _loom_failed=0; local _loom_ok,_loom_value;\n_loom_ok, _loom_value = pcall(function()\n        local TextService = game:GetService(\"TextService\")\n        local SS = Enum.Font.SourceSans\n        local BIG = Vector2.new(1e4, 1e4)\n        local w1 = TextService:GetTextSize(\"a\", 24, SS, BIG).X\n        local w2 = TextService:GetTextSize(\"aaaaaaaaaa\", 24, SS, BIG).X\n        return w2 > w1\n    end); if not _loom_ok or _loom_value ~= true then _loom_failed = _loom_failed + 1 end\nreturn _loom_failed"}],"format":"LoomCheckPool","robloxCount":71,"provenance":{"repository":"kingofluau/Loom","commit":"d4e04c12928c813cb19142cc9d3facae854034a3","path":"src/vm/Bootstrap.lua","sha256":"569200113f9760395f3e9edbb6c2fc831c13031aeb259caf247729d878536454"},"license":"MIT License\n\nCopyright (c) 2026 Loom Contributors\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documen