local output = "loom-checks.json"
assert(type(writefile) == "function", "writefile is required")
assert(type(loadstring) == "function", "loadstring is required")
local report = {
    metadata = {
        complete = false,
        provenance = pool.provenance,
        license = pool.license,
        placeId = game.PlaceId,
        gameId = game.GameId,
        robloxVersion = version(),
        scope = "Isolated check-pool predicates; full bootstrap and VM excluded",
    },
    checks = {},
    totals = { pass = 0, fail = 0, error = 0 },
}
if type(identifyexecutor) == "function" then
    local ok, name, build = pcall(identifyexecutor)
    if ok then report.metadata.executor = tostring(name); report.metadata.executorVersion = tostring(build) end
end
local function save()
    writefile(output, http:JSONEncode(report))
end
save()
for index, check in ipairs(pool.checks) do
    local compiled, callback, failure = pcall(loadstring, check.source, "loom:" .. check.id)
    local result = { id = check.id, group = check.group }
    if not compiled or type(callback) ~= "function" then
        result.status = "error"
        result.error = tostring(if compiled then failure else callback):sub(1, 4096)
    else
        local ok, count = pcall(callback)
        if not ok then
            result.status = "error"
            result.error = tostring(count):sub(1, 4096)
        else
            result.status = if count == 0 then "pass" else "fail"
            result.failedAssertions = if type(count) == "number" then count else nil
        end
    end
    report.totals[result.status] += 1
    table.insert(report.checks, result)
    if index % 10 == 0 then save(); task.wait() end
end
report.metadata.complete = true
save()
print(string.format("Loom: %d passed, %d failed, %d errors; saved %s", report.totals.pass, report.totals.fail, report.totals.error, output))
